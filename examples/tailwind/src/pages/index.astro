---
import Layout from "../layouts/Layout.astro";

const perks = [
  { title: "Baked at 5am", text: "Sourdough, rye and seeded loaves, out of the oven before the first tram." },
  { title: "Local flour", text: "Milled forty kilometres away; we visit the mill every season." },
  { title: "No waste", text: "Whatever is left at closing goes to the shelter on Karl-Marx-Straße." },
];
---
<Layout title="Northwind Bakery">
  <section class="rounded-3xl bg-brand-soft p-10">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand">Neukölln · since 2019</p>
    <h1 class="mt-3 text-5xl font-extrabold tracking-tight">Bread worth crossing town for.</h1>
    <p class="mt-4 max-w-xl text-lg text-slate-700">A small bakery, a long fermentation, and a queue that moves fast.</p>
    <a href="/menu" class="mt-8 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-white shadow hover:bg-teal-800">See the menu</a>
  </section>
  <section class="mt-12 grid gap-6 md:grid-cols-3">
    {perks.map((p) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">{p.title}</h2>
        <p class="mt-2 text-slate-600">{p.text}</p>
      </article>
    ))}
  </section>
</Layout>

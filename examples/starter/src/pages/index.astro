---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { products, formatPrice } from "@/data/products";

const headline = "Design that ships.";
---
<Layout title="Home">
  <section class="hero">
    <p class="eyebrow">Studio · Berlin</p>
    <h1>{headline}</h1>
    <p class="lede">We are a two-person studio building brands and websites for teams who would rather launch than wait.</p>
    <div class="actions">
      <a class="button" href="/about">Meet the studio</a>
      <a class="button secondary" href="/blog">Read the journal</a>
    </div>
  </section>

  <section>
    <h2>What we do</h2>
    <div class="grid">
      {products.map((p) => <Card title={p.name} text={p.blurb} price={formatPrice(p.price)} href={`/blog`} />)}
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 24px 0 48px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px; color: var(--muted); margin: 0 0 8px; }
  h1 { font-size: clamp(38px, 7vw, 64px); line-height: 1.02; margin: 0 0 16px; letter-spacing: -0.02em; }
  .lede { font-size: 19px; color: var(--muted); max-width: 560px; }
  .actions { display: flex; gap: 12px; margin-top: 22px; }
  h2 { margin: 0 0 16px; }
</style>
